# Frontend environment (Vite exposes only VITE_* vars, and they are PUBLIC).
# Never put API keys here: AI calls go through the backend.

# false = run fully on the in-browser mock store (demo mode)
# true  = try the backend first and fall back to mock if it is unreachable
VITE_USE_REAL_API=false

# Backend base URL, e.g. http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Optional: landing-page hero video (defaults to a free Mixkit clip)
VITE_HERO_VIDEO_URL=
